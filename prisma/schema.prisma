generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==============================
// ✅ Management Staffs Schema
// ==============================
model ManagementStaff {
  id              String                   @id @unique @default(uuid())
  email           String                   @unique
  password        String
  employeeId      String?                  @unique
  role            ManagementStaffModelRole
  phone           String?
  alt_phone       String?
  name            String
  profile_img_url String?
  address         String?
  emailVerified   Boolean                  @default(false)
  fcm_token       String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  deletedAt       DateTime?

  // One-to-Many: One staff can create multiple tickets
  supportTicketsModel        SupportTicketDetail[]
  // One-to-Many: One staff can create multiple leave requests
  LeaveRequestModel          LeaveDetail[]
  // One-to-Many: One staff can manage multiple batches
  batchDetailModel           BatchDetail[]
  // One-to-Many: One staff can be assigned multiple students
  studentModel               Student[]
  // One-to-Many: One staff can send multiple notifications
  notificationModel          Notification[]
  // One-to-Many: One staff can receive multiple notifications
  notificationRecipientModel NotificationRecipient[]

  @@index([id])
  @@index([email])
  @@index([employeeId])
  @@index([emailVerified])
  @@index([fcm_token])
  @@map("management_staff") // Mapping to actual table name
}

enum ManagementStaffModelRole {
  admin
  counsellor
  staff
  guest
}

// ==============================
// ✅ Student Model
// ==============================
model Student {
  id                    String    @id @default(uuid())
  lms_id                String    @db.VarChar(20)
  name                  String    @db.VarChar(191)
  phone                 String?   @db.VarChar(191) // Nullable
  alt_phone             String?   @db.VarChar(191) // Nullable
  Dob                   String?
  email                 String    @unique @db.VarChar(191)
  profile_img_url       String?
  password              String?   @db.VarChar(191) // Nullable
  roll_number           String    @unique @db.VarChar(191)
  Qualification         String?   @db.VarChar(30)
  Yop                   String?
  Profession            String?   @db.VarChar(20)
  C_Name                String?   @db.VarChar(100)
  address               String?   @db.VarChar(191) // Nullable
  City                  String?   @db.VarChar(20)
  Pincode               String?
  Global_Certification  String?   @db.VarChar(20)
  Course                String?   @db.VarChar(50)
  Fees                  Int?
  Batch_time            String?   @db.VarChar(20)
  Demo                  String?   @db.VarChar(20)
  Joining_Date          DateTime? @db.Date
  Know_about_iie        String?   @db.VarChar(20)
  Frd_Name              String?   @db.VarChar(100)
  Branch                String?   @db.VarChar(20)
  Follow_up             DateTime? @db.Date
  Status                String?   @db.VarChar(20)
  Remarks               String?   @db.VarChar(100)

  // One-to-One: A student is assigned to one counsellor
  counsellor_id             String          @db.VarChar(191)
  counsellor_name           String          @db.VarChar(191) // Not a relation, Just a stored field
  management_staff_relation ManagementStaff @relation(fields: [counsellor_id], references: [id], onDelete: Cascade)

  Walkin_By       String?   @db.VarChar(20)
  Walkin_Date     DateTime? @db.Date
  DateTime        DateTime? @default(now()) @updatedAt
  emailVerified   Boolean   @default(false) // Tinyint(1) mapped to Boolean
  preferred_batch String    @db.VarChar(191)
  course_id       String    @db.VarChar(191)
  fcm_token       String?
  createdAt       DateTime  @default(now()) @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @db.DateTime(3)
  deletedAt       DateTime? // Nullable for soft delete

  // Many-to-Many: Student can be in multiple batches
  batchWithStudentModel      BatchWithStudent[]
  notificationRecipientModel NotificationRecipient[]
  SupportTicket              SupportTicketDetail[]
  LeaveManagementStaff       LeaveDetail[]
  AttendanceDetail           StudentAttendanceDetail[]

  @@index([name, roll_number, email, phone])
  @@map("student") // Mapping to actual table name
}

// ==============================
// ✅ Support Ticket Schema
// ==============================
model SupportTicketDetail {
  id                  String         @id @default(uuid())
  management_staff_id String? // Nullable - If role is staff or counsellor
  student_id          String? // Nullable - If role is student
  role                CommonUserRole
  query               String // Reason for raising the ticket
  status              TicketStatus   @default(open)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime? // Soft delete column

  // One-to-One (Optional): A ticket is linked to only one management staff or student
  management_staff_relation ManagementStaff? @relation(fields: [management_staff_id], references: [id], onDelete: Cascade, map: "SupportTicket_ManagementStaff_fkey") // Optional relation
  student_relation          Student?         @relation(fields: [student_id], references: [id], onDelete: Cascade, map: "SupportTicket_Student_fkey") // Optional relation

  @@index([management_staff_id])
  @@index([student_id])
  @@index([status])
  @@map("support_ticket_Detail") // Mapping to actual table name
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

enum CommonUserRole {
  admin
  counsellor
  staff
  guest
  student
}

// ==============================
// ✅ Apply Leave Schema
// ==============================
model LeaveDetail {
  id                  String  @id @default(uuid()) // Unique Leave ID
  management_staff_id String? // Nullable - If role is staff or counsellor
  student_id          String? // Nullable - If role is student

  // One-to-One (Optional): A leave request is linked to only one management staff or student
  management_staff_relation ManagementStaff? @relation(fields: [management_staff_id], references: [id], onDelete: Cascade, map: "Leave_ManagementStaff_fkey")
  student_relation          Student?         @relation(fields: [student_id], references: [id], onDelete: Cascade, map: "Leave_Student_fkey")

  role       CommonUserRole
  leave_type LeaveType
  leave_mode LeaveMode
  from_date  String // Leave start date
  to_date    String // Leave end date
  reason     String // Reason for leave
  status     LeaveStatus    @default(Pending) // Leave approval status
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime? // Soft delete column

  @@index([management_staff_id])
  @@index([student_id])
  @@index([status])
  @@map("leave_detail") // Mapping to actual table name
}

enum LeaveType {
  Sick
  Casual
  Earned
  Unpaid
  Other
}

enum LeaveMode {
  Half_Day
  Full_Day
}

enum LeaveStatus {
  Pending
  Approved
  Rejected
  Cancelled
}

// ==============================
// ✅ Batch Schema
// ==============================
model BatchDetail {
  id                String         @id @unique @default(uuid())
  batch_number      String         @unique
  batchName         String?
  batch_stud_count  String
  from_date         String
  to_date           String
  course            String
  slot              BatchSlotsType
  session_sheet_url String? // SessionSheet file URLs

  // One-to-Many: One mentor can manage multiple batches
  mentor_id                 String
  management_staff_relation ManagementStaff @relation(fields: [mentor_id], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Many-to-Many: A batch can have multiple students
  batchWithStudentModel      BatchWithStudent[]
  notificationRecipientModel NotificationRecipient[]
  // sessionSheetDetailModel    SessionSheetDetail[]
  AttendanceDetail           StudentAttendanceDetail[]

  @@index([id])
  @@index([mentor_id]) // Index for faster lookups
  @@map("batch_detail") // Mapping to actual table name
}

enum BatchSlotsType {
  morning
  evening
}

// ========================================================================
// ✅ Join Table for Many-to-Many Relation (Student and BatchDetail models)
// ========================================================================
model BatchWithStudent {
  batch_id   String
  student_id String

  batch_detail_relation BatchDetail @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  student_relation      Student     @relation(fields: [student_id], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) // Automatically stores created time
  deletedAt DateTime? // Nullable field for soft delete

  @@id([batch_id, student_id]) // Composite Primary Key
  @@map("batch_with_student")
}

model StoredOTPDetail {
  id        String    @id @default(uuid())
  email     String
  otp       String
  // otp       String    @unique
  createdAt DateTime  @default(now()) // Automatically stores created time
  updatedAt DateTime  @updatedAt // Automatically updates updated time
  deletedAt DateTime? // Nullable field for soft delete

  @@index([email])
  @@map("stored_otp_detail")
}

model Notification {
  id          String                @id @default(uuid())
  senderId    String // Foreign key for sender (ManagementStaff)
  title       String
  description String
  image       String?
  type        NotificationType // Enum for notification type
  category    NotificationCategory? // Optional category field
  batch_ids   String // Optional: String of batch IDs
  student_ids String // Optional: String of student IDs
  date        String
  time        String
  scheduledAt BigInt? // The exact datetime when the notification should be sent
  status      NotificationStatus    @default(Scheduled) // Default status should be "Scheduled"
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  deletedAt   DateTime? // Soft delete

  // Relation: Notification is sent by a ManagementStaff (One-to-One)
  management_staff_relation ManagementStaff @relation(fields: [senderId], references: [id], onDelete: Cascade)

  // Relation: One Notification can have multiple recipients (One-to-Many)
  notificationRecipientModel NotificationRecipient[]

  // Index for faster queries based on senderId
  @@index([senderId])
  // Map to the actual table name in the database
  @@map("notification")
}

model NotificationRecipient {
  id                String             @id @default(uuid())
  notificationId    String // Foreign key for Notification
  managementStaffId String? // Foreign key for staff
  studentId         String? // Foreign key for student
  batchId           String? // Foreign key for batch
  receiverRole      ReceiverRole // Enum: staff, guest, student
  type              NotificationType
  isRead            Boolean            @default(false) // Read status
  status            NotificationStatus @default(Scheduled) // Default status should be "Scheduled"
  sentAt            BigInt? // Timestamp when notification was sent
  createdAt         DateTime           @default(now())

  // Relation: One NotificationRecipient belongs to one Notification (Many-to-One)
  notification_relation Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  // Relation: A NotificationRecipient may be associated with a ManagementStaff (Optional)
  management_staff_relation ManagementStaff? @relation(fields: [managementStaffId], references: [id], onDelete: Cascade, map: "NotificationRecipient_managementStaffId_fkey")

  // Relation: A NotificationRecipient may be associated with a Student (Optional)
  student_relation Student? @relation(fields: [studentId], references: [id], onDelete: Cascade, map: "NotificationRecipient_studentId_fkey")

  // Relation: A NotificationRecipient may be associated with a BatchDetail (Optional)
  batch_detail_relation BatchDetail? @relation(fields: [batchId], references: [id], onDelete: Cascade, map: "NotificationRecipient_batchId_fkey")

  @@index([notificationId])
  @@index([managementStaffId])
  @@index([studentId])
  @@index([batchId])
  @@map("notification_recipient")
}

enum NotificationStatus {
  Scheduled // Notification is scheduled for a future time
  Pending // Notification time has arrived but not yet sent
  Sent // Notification has been successfully sent
  Failed // Notification failed to send
}

enum NotificationCategory {
  all
  staffs
  students
}

enum ReceiverRole {
  staff
  guest
  student
}

enum NotificationType {
  course_test
  mock_test
  leave
  support_ticket
  message
  material_uploaded
  session_uploaded
  session_completed
}

