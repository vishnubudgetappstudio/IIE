// ==============================
// ✅ Attendance Schema - Student
// ==============================
model StudentAttendanceDetail {
  id              String           @id @default(uuid())
  batch_id        String
  student_id      String
  attendance_date DateTime         @default(now())
  is_present      Boolean
  status          AttendanceStatus @default(present)
  createdAt       DateTime         @default(now()) // Automatically stores created time
  updatedAt       DateTime         @updatedAt // Automatically updates updated time
  deletedAt       DateTime? // Nullable field for soft delete

  // Relations
  batch_detail_relation BatchDetail @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  student_relation      Student     @relation(fields: [student_id], references: [id], onDelete: Cascade)

  // ✅ Ensures one attendance record per student per batch per day
  @@unique([batch_id, student_id, attendance_date])
  @@map("student_attendance")
}

enum AttendanceStatus {
  present
  absent
}

