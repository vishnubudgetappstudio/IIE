// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==============================
// ✅ Management Staffs Schema
// ==============================
model ManagementStaff {
  id              String                   @id @unique @default(uuid())
  email           String                   @unique
  password        String
  employeeId      String?                  @unique
  role            ManagementStaffModelRole
  phone           String?
  alt_phone       String?
  name            String
  branch          String?
  profile_img_url String?
  address         String?
  emailVerified   Boolean                  @default(false)
  fcm_token       String?
  is_login        Int      @default(0)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  deletedAt       DateTime?

  // One-to-Many: One staff can create multiple tickets
  supportTicketsModel        SupportTicketDetail[]
  // One-to-Many: One staff can create multiple leave requests
  LeaveRequestModel          LeaveDetail[]
  // One-to-Many: One staff can manage multiple batches
  batchDetailModel           BatchDetail[]
  // One-to-Many: One staff can be assigned multiple students
  studentModel               Student[]
  // One-to-Many: One staff can send multiple notifications
  notificationModel          Notification[]
  // One-to-Many: One staff can receive multiple notifications
  notificationRecipientModel NotificationRecipient[]
  // One-to-Many: One staff can receive multiple files
  xlsFileDetailModel         XlsFileDetail[]

  materialFileDetails        MaterialFileDetail[]

  @@index([id])
  @@index([email])
  @@index([employeeId])
  @@index([emailVerified])
  @@index([fcm_token])
  @@map("management_staff") // Mapping to actual table name
}

enum ManagementStaffModelRole {
  admin
  counsellor
  staff
  guest
}

// ==============================
// ✅ Student Model
// ==============================
model Student {
  id                   String    @id @default(uuid())
  lms_id               String    @db.VarChar(20)
  name                 String    @db.VarChar(191)
  phone                String?   @db.VarChar(191) // Nullable
  alt_phone            String?   @db.VarChar(191) // Nullable
  Dob                  String?
  email                String    @unique @db.VarChar(191)
  profile_img_url      String?
  password             String?   @db.VarChar(191) // Nullable
  roll_number          String    @unique @db.VarChar(191)
  Qualification        String?   @db.VarChar(30)
  Yop                  String?
  Profession           String?   @db.VarChar(20)
  C_Name               String?   @db.VarChar(100)
  address              String?   @db.VarChar(191) // Nullable
  City                 String?   @db.VarChar(20)
  Pincode              String?
  Global_Certification String?   @db.VarChar(20)
  Course               String?   @db.VarChar(50)
  Fees                 Int?
  Batch_time           String?   @db.VarChar(20)
  Demo                 String?   @db.VarChar(20)
  Joining_Date         DateTime? @db.Date
  Know_about_iie       String?   @db.VarChar(20)
  Frd_Name             String?   @db.VarChar(100)
  Branch               String?   @db.VarChar(20)
  Follow_up            DateTime? @db.Date
  Status               String?   @db.VarChar(20)
  Remarks              String?   @db.VarChar(100)
  is_login             Int      @default(0)

  // One-to-One: A student is assigned to one counsellor
  //sessionReports SessionSheetStudentReportDetail[]
  sessionReports SessionSheetStudentReportDetail[]
  counsellor_id             String          @db.VarChar(191)
  counsellor_name           String          @db.VarChar(191) // Not a relation, Just a stored field
  management_staff_relation ManagementStaff @relation(fields: [counsellor_id], references: [id], onDelete: Cascade)
  
  

  Walkin_By       String?   @db.VarChar(20)
  Walkin_Date     DateTime? @db.Date
  DateTime        DateTime? @default(now()) @updatedAt
  emailVerified   Boolean   @default(false) // Tinyint(1) mapped to Boolean
  preferred_batch String    @db.VarChar(191)
  course_id       String    @db.VarChar(191)
  fcm_token       String?
  createdAt       DateTime  @default(now()) @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @db.DateTime(3)
  deletedAt       DateTime? // Nullable for soft delete

  // Many-to-Many: Student can be in multiple batches
  batchWithStudentModel      BatchWithStudent[]
  notificationRecipientModel NotificationRecipient[]
  SupportTicketModel         SupportTicketDetail[]
  LeaveManagementStaffModel  LeaveDetail[]
  AttendanceDetailModel      StudentAttendanceDetail[]
  StudentMaterialAccessModel StudentMaterialAccess[]
  StudentCourseTest          Test_Course_Or_Mock_With_Student[]

  @@index([name, roll_number, email, phone])
  @@map("student") // Mapping to actual table name
}

// ==============================
// ✅ Support Ticket Schema
// ==============================
model SupportTicketDetail {
  id                  String         @id @default(uuid())
  management_staff_id String? // Nullable - If role is staff or counsellor
  student_id          String? // Nullable - If role is student
  //group_id           String? // Nullable - If role is group
  role                CommonUserRole
  query               String // Reason for raising the ticket
  status              TicketStatus   @default(open)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime? // Soft delete column

  // One-to-One (Optional): A ticket is linked to only one management staff or student
  guest_id   String?  // Foreign key for Guest
  guest      Guest?   @relation(fields: [guest_id], references: [id])
  management_staff_relation ManagementStaff? @relation(fields: [management_staff_id], references: [id], onDelete: Cascade, map: "SupportTicket_ManagementStaff_fkey") // Optional relation
  student_relation          Student?         @relation(fields: [student_id], references: [id], onDelete: Cascade, map: "SupportTicket_Student_fkey") // Optional relation

  @@index([management_staff_id])
  @@index([student_id])
  @@index([status])
  @@map("support_ticket_Detail") // Mapping to actual table name
}

enum TicketStatus {
  open
  in_progress
  resolved
  closed
}

enum CommonUserRole {
  admin
  counsellor
  staff
  guest
  student
}

// ==============================
// ✅ Apply Leave Schema
// ==============================
model LeaveDetail {
  id                  String  @id @default(uuid()) // Unique Leave ID
  management_staff_id String? // Nullable - If role is staff or counsellor
  student_id          String? // Nullable - If role is student

  // One-to-One (Optional): A leave request is linked to only one management staff or student
  management_staff_relation ManagementStaff? @relation(fields: [management_staff_id], references: [id], onDelete: Cascade, map: "Leave_ManagementStaff_fkey")
  student_relation          Student?         @relation(fields: [student_id], references: [id], onDelete: Cascade, map: "Leave_Student_fkey")
  notificationRecipients NotificationRecipient[] @relation("LeaveDetailToNotification")

  role       CommonUserRole
  leave_type LeaveType
  leave_mode LeaveMode?
  from_date  DateTime // Leave start date
  to_date    DateTime // Leave end date
  reason     String // Reason for leave
  status     LeaveStatus    @default(Pending) // Leave approval status
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime? // Soft delete column

  @@index([management_staff_id])
  @@index([student_id])
  @@index([status])
  @@map("leave_detail") // Mapping to actual table name
}

enum LeaveType {
  Sick
  Casual
  Earned
  Unpaid
  Absent
  Other
}

enum LeaveMode {
  Half_Day
  Full_Day
}

enum LeaveStatus {
  Pending
  Approved
  Rejected
  Not_informed
}

// ==============================
// ✅ Batch Schema
// ==============================
model BatchDetail {
  id               String         @id @unique @default(uuid())
  batch_number     String         @unique
  batchName        String?
  batch_stud_count String
  from_date        String
  to_date          String
  start_time       String    // Added start_time field
  end_time         String 
  batch_status     String?
  course           String
  is_marked        Boolean   @default(false)
  slot             BatchSlotsType

  // One-to-Many: One mentor can manage multiple batches
  mentor_id                 String
  management_staff_relation ManagementStaff @relation(fields: [mentor_id], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Many-to-Many: A batch can have multiple students
  batchWithStudentModel                BatchWithStudent[]
  notificationRecipientModel           NotificationRecipient[]
  AttendanceDetailModel                StudentAttendanceDetail[]
  SessionSheetDetailModel              SessionSheetDetail[]
  SessionSheetStudentReportDetailModel SessionSheetStudentReportDetail[]
  MaterialFileDetailModel              MaterialFileDetail[]
  CourseTestModel                      Test_Course[]
  StudentCourseOrMockTestModel         Test_Course_Or_Mock_With_Student[]
  MockTestModel                        Test_Mock[]

  @@index([id])
  @@index([mentor_id]) // Index for faster lookups
  @@map("batch_detail") // Mapping to actual table name
}

enum BatchSlotsType {
  morning
  evening
}

// ========================================================================
// ✅ Join Table for Many-to-Many Relation (Student and BatchDetail models)
// ========================================================================
model BatchWithStudent {
  batch_id   String
  student_id String

  batch_detail_relation BatchDetail @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  student_relation      Student     @relation(fields: [student_id], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) // Automatically stores created time
  deletedAt DateTime? // Nullable field for soft delete

  @@id([batch_id, student_id]) // Composite Primary Key
  @@map("batch_with_student")
}

model StoredOTPDetail {
  id        String    @id @default(uuid())
  email     String
  otp       String
  // otp       String    @unique
  createdAt DateTime  @default(now()) // Automatically stores created time
  updatedAt DateTime  @updatedAt // Automatically updates updated time
  deletedAt DateTime? // Nullable field for soft delete

  @@index([email])
  @@map("stored_otp_detail")
}

model Notification {
  id          String                @id @default(uuid()) // Notification ID
  senderId    String                // Foreign key for sender (ManagementStaff)
  title       String                // Title of the notification
  description String                // Description of the notification
  image       String?               // Optional image field
  type        NotificationType      // Type of notification (custom type)
  category    NotificationCategory? // Optional category (custom type)
  batch_ids   String?               // Optional: Comma-separated batch IDs (nullable)
  student_ids String?               // Optional: Comma-separated student IDs (nullable)
  date        String                // Date of the notification
  time        String                // Time of the notification
  scheduledAt BigInt?               // Timestamp when notification should be sent (nullable)
  status      NotificationStatus    @default(Scheduled) // Default status is Scheduled
  createdAt   DateTime              @default(now())    // Timestamp of creation
  updatedAt   DateTime              @updatedAt          // Auto-updated on changes
  deletedAt   DateTime?             // Soft delete field (nullable)

  // Relations
  
  management_staff_relation  ManagementStaff         @relation(fields: [senderId], references: [id], onDelete: Cascade) // Foreign key to ManagementStaff
  notificationRecipientModel NotificationRecipient[] // Related recipients

  // Indexes for faster queries
  @@index([senderId, status]) // Index for fast queries on sender and status
  @@index([scheduledAt])       // Index for fast queries on scheduledAt
  @@map("notification")        // Map the table name to "notification"
}


model NotificationRecipient {
  id                String             @id @default(uuid())
  notificationId    String?
  title             String
  description       String
  managementStaffId String?
  studentId         String?
  batchId           String?
  receiverRole      ReceiverRole
  type              NotificationType
  isRead            Boolean            @default(false)
  status            NotificationStatus @default(Scheduled)
  leaveDetailId     String?
  material_id       String?
  test_id           String?
  session_id        String?
  session_index_id  String?
  sentAt            BigInt?
  createdAt         DateTime           @default(now())

  notification_relation     Notification?     @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  management_staff_relation ManagementStaff? @relation(fields: [managementStaffId], references: [id], onDelete: Cascade)
  student_relation          Student?         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  batch_detail_relation     BatchDetail?     @relation(fields: [batchId], references: [id], onDelete: Cascade)

  // ✅ Add relation name
  leaveDetail LeaveDetail? @relation("LeaveDetailToNotification", fields: [leaveDetailId], references: [id])

  materialDetail MaterialFileDetail? @relation("MaterialDetailToNotification", fields: [material_id], references: [id])

  testCourseDetailRelation      Test_Course?       @relation("TestDetailToNotification", fields: [test_id], references: [id])

  @@index([notificationId, status])
  @@index([managementStaffId])
  @@index([studentId])
  @@index([batchId])
  @@map("notification_recipient")
}


enum NotificationStatus {
  Scheduled // Notification is scheduled
  Pending // Notification is waiting to be sent
  Sent // Successfully sent
  Failed // Failed to send
}

enum NotificationCategory {
  all
  staffs
  students
}

enum ReceiverRole {
  staff
  guest
  student
}

enum NotificationType {
  course_test
  mock_test
  leave
  support_ticket
  message
  material_uploaded
  session_uploaded
  session_completed
}

// ==============================
// ✅ SessionSheet Schema
// ==============================
model SessionSheetDetail {
  id                String             @id @default(uuid())
  batch_id          String
  session_file_name String
  session_file_url  String             @db.Text
  status            SessionSheetStatus
  createdAt         DateTime           @default(now()) // Automatically stores created time
  updatedAt         DateTime           @updatedAt // Automatically updates updated time
  deletedAt         DateTime? // Nullable field for soft delete

  // Relation: Each session sheet belongs to a specific batch (One-to-One)
  batch_detail_relation                BatchDetail                       @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  SessionSheetStudentReportDetailModel SessionSheetStudentReportDetail[]

  @@unique([id, batch_id])
  @@index([id, batch_id, session_file_name, status])
  @@map("session_sheet_detail")
}

enum SessionSheetStatus {
  Completed
  HaveDoubt @map("Have doubt")
  Incomplete @map("inComplete")
  NotMarked
}

// =======================================
// ✅ SessionSheet - Student Report Schema
// =======================================
model SessionSheetStudentReportDetail {
  id               String             @id @unique @default(uuid())
  batch_id         String
  session_sheet_id String
  student_id       String
  status           SessionSheetStatus
  session_index_id String?
  createdAt        DateTime           @default(now()) // Automatically stores created time
  updatedAt        DateTime           @updatedAt // Automatically updates updated time
  deletedAt        DateTime? // Nullable field for soft delete

  // Relation: Each session sheet belongs to a specific batch (One-to-One)
  student    Student @relation(fields: [student_id], references: [id])
 // student    Student @relation(fields: [student_id], references: [id])
  batch_detail_relation         BatchDetail        @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  session_sheet_detail_relation SessionSheetDetail @relation(fields: [session_sheet_id], references: [id], onDelete: Cascade)

  @@index([id, session_sheet_id, status])
  @@map("session_sheet_student_report_detail")
}

enum SessionSheetReportStatus {
  completed
  have_doubt
  not_marked
}

// ==============================
// ✅ Material File Schema
// ==============================
model MaterialFileDetail {
  id                String                   @id @unique @default(uuid())
  batch_id          String?
  staff_id          String
  material_title    String
  material_file_url String                   @db.Text
  status            MaterialFileDetailStatus @default(draft)
  delete_request    String?  // 'pending' | 'approved' | null
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime?
  deletedAt         DateTime?

  // Relation: Each material belongs to a specific batch
  batch_detail_relation BatchDetail? @relation(fields: [batch_id], references: [id], onDelete: Cascade)

  // Relation: Many-to-Many with Students via `StudentMaterialAccess`
  studentMaterialAccessModel StudentMaterialAccess[]

  notificationRecipients NotificationRecipient[] @relation("MaterialDetailToNotification")

  staff ManagementStaff @relation(fields: [staff_id], references: [id], onDelete: Cascade)

  @@map("material_file_detail")
}

enum MaterialFileDetailStatus {
  draft
  published
}

// ==============================
// ✅ Student Material Access Schema
// ==============================
model StudentMaterialAccess {
  id             String   @id @unique @default(uuid())
  student_id     String
  material_id    String
  access_granted Boolean  @default(false) // Default: No access
  createdAt      DateTime @default(now())

  // Relations
  student_relation  Student            @relation(fields: [student_id], references: [id], onDelete: Cascade)
  material_relation MaterialFileDetail @relation(fields: [material_id], references: [id], onDelete: Cascade)

  @@unique([student_id, material_id]) // Ensures one entry per student-material pair
  @@map("student_material_access")
}

// ==============================
// ✅  XLS File Detail Schema
// ==============================
model XlsFileDetail {
  id                  String    @id @unique @default(uuid())
  management_staff_id String
  xls_file_name       String    @unique
  xls_file_url        String    @db.Text
  createdAt           DateTime  @default(now()) // Automatically stores created time
  updatedAt           DateTime?
  deletedAt           DateTime? // Nullable field for soft delete

  // Relation: Each session sheet belongs to a specific batch (One-to-One)
  management_staff_relation ManagementStaff @relation(fields: [management_staff_id], references: [id], onDelete: Cascade)

  @@index([id, management_staff_id, xls_file_name])
  @@map("xls_file_detail")
}

// ==============================
// ✅ Attendance Schema - Student
// ==============================
model StudentAttendanceDetail {
  id              String           @id @default(uuid())
  batch_id        String
  student_id      String
  attendance_date DateTime         @default(now())
  is_present      Boolean
  status          AttendanceStatus @default(present)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?

  batch_detail_relation BatchDetail @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  student_relation      Student     @relation(fields: [student_id], references: [id], onDelete: Cascade)

  // Unique constraint: One attendance record per student per batch per day
  @@unique([student_id, batch_id, attendance_date])

  @@index([id, batch_id])
  @@map("student_attendance")
}

enum AttendanceStatus {
  present
  absent
}

// =============================================
// ✅ Course Test or upload CSV Test file Schema 
// =============================================
model Test_Course {
  id               String    @id @default(uuid())
  batch_id         String?   // Made optional
  batch_name       String
  test_title       String
  test_description String    @db.Text
  test_url         String?   @db.Text
  start_date       DateTime
  end_date         DateTime
  timer            String    // e.g., "1:30 hours" or "45 mins"
  questions        String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  batch_detail_relation            BatchDetail?                       @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  TestCourseOrMockWithStudentModel Test_Course_Or_Mock_With_Student[]

  notificationRecipients NotificationRecipient[] @relation("TestDetailToNotification")

  @@index([batch_id, test_title])
  @@map("test_course")
}




// =============================================
// ✅ Mock Test or upload CSV Test file Schema 
// =============================================
model Test_Mock {
  id         String       @id @default(uuid())
  batch_id   String?      // ✅ batch_id is optional
  batch_name String
  test_url   String?      @db.Text
  test_mode  MockTestMode @default(easy)
  questions  String?      @db.Text
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deletedAt  DateTime?

  // ✅ Relation is optional by using `?` on the relation name
  batch_detail_relation  BatchDetail?  @relation(fields: [batch_id], references: [id], onDelete: Cascade)

  TestCourseOrMockWithStudentModel Test_Course_Or_Mock_With_Student[]

  @@index([batch_id])
  @@map("test_mock")
}


model Test_Course_Or_Mock_With_Student {
  id           String   @id @default(uuid())
  batchId      String
  studentId    String
  courseTestId String? // Only used if test_type = COURSE
  mockTestId   String? // Only used if test_type = MOCK
  test_type    TestType

  // Core fields
  status                  StudentTestStatus @default(yet_to_start)
  submittedAt             DateTime?
  score                   String?
  total_questions_count   String?
  correct_answers_count   String?
  incorrect_answers_count String?
  score_status            ScoreStatus?


  createdAt DateTime  @default(now())
  updatedAt DateTime?
  deletedAt DateTime?

  // Relations
  batch_detail_relation BatchDetail @relation(fields: [batchId], references: [id], onDelete: Cascade)
  student_relation      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  course_test_relation Test_Course? @relation(fields: [courseTestId], references: [id], onDelete: Cascade)
  mock_test_relation   Test_Mock?   @relation(fields: [mockTestId], references: [id], onDelete: Cascade)

  @@index([studentId, courseTestId, mockTestId, status, test_type])
  @@map("test_course_or_mock_with_student")
}

enum StudentTestStatus {
  yet_to_start
  drafted
  completed
}

enum ScoreStatus {
  poor
  average
  good
}

enum TestType {
  mock_test
  course_test
}

enum MockTestMode {
  easy
  medium
  hard
}


model Guest {
  id        String   @id @default(uuid())
  phone     String   @unique
  otpCode   String?
  name      String?
  email     String?
  course    String?
  area      String?
  createdAt DateTime @default(now())

  supportTickets SupportTicketDetail[] // 👈 add this line for back relation
}



